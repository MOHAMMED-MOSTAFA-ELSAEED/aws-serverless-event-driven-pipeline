{
  "Comment": "Distributed State Machine for Payload Processing and DLQ Error Handling",
  "StartAt": "ProcessDataPayload",
  "States": {
    "ProcessDataPayload": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:YOUR_ACCOUNT_ID:function:ServerlessDataProcessorLambda",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "SendToDeadLetterQueue"
        }
      ],
      "End": true
    },
    "SendToDeadLetterQueue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/FailedRecordsDLQ",
        "MessageBody.$": "$"
      },
      "Next": "NotifyOpsTeam"
    },
    "NotifyOpsTeam": {
      "Type": "Task",
      "Resource": "arn:aws:sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:CriticalPipelineAlerts",
        "Subject": "ALERT: Serverless Pipeline Failure Detected",
        "Message.$": "$"
      },
      "End": true
    }
  }
}
